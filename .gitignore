
# ===== Secrets =====
# .env.example만 예외로 추적 — 어떤 변수가 필요한지는 공유, 값은 공유 금지
.env
.env.*
!.env.example
*.pem
# RDS 서울 루트 인증서는 비밀값이 아닌 공개 인증서라 추적한다(deploy/aws/k8s/README.md 「Secret과 ConfigMap」)
!deploy/aws/db/rds-ca-rsa2048-g1.pem
*.key
*.p12
credentials.json
*-service-account.json

# ===== 로컬 탐색 격리 =====
_sandbox/
_notes/

# ===== RAG 평가 원문 =====
# 평가 입력·답 항목·인용 원문은 저장소에 넣지 않는다(U5 기능 설계 BR10.5, api/docs/rag-answer.md 「RAG 품질 평가」)
api/.rag-eval/

# ===== 안전망 =====
# 앱별 .gitignore가 있지만, 루트에서 실수로 install한 경우를 잡는다
node_modules/
__pycache__/

