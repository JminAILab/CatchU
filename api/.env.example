# 필수: 각 개발 환경에서 안전하게 생성한 32바이트 무작위 키의 64자리 hex 표현.
# 실제 키나 기본 서명 키를 이 예시에 넣지 않습니다. README의 생성 절차를 따르세요.
AUTH_JWT_SECRET=
# 필수: #250 팀장 결정의 Access 15분. 다른 값은 기동 거부.
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
# 운영 필수: 정확한 동일 출처 HTTPS web 주소. 개발/test 기본은 http://localhost:3000.
AUTH_WEB_ORIGIN=http://localhost:3000
# 선택: 정확히 true이고 NODE_ENV가 development 또는 test일 때만 개발용 로그인 허용. 기본 비활성화.
DEV_LOGIN_ENABLED=false
# 선택: 실제 Google 로그인을 쓸 때만 true. 기본 비활성화.
GOOGLE_LOGIN_ENABLED=false
# Google 로그인을 켜면 필수: 웹 OAuth 클라이언트 ID·비밀값·등록한 정확한 콜백 주소.
# 비밀값은 로컬 .env에만 넣고 Git·로그·대화에 공유하지 않습니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 개발/test만 loopback HTTP 허용. 운영은 HTTPS. 주소에는 query·fragment를 넣지 않습니다.
GOOGLE_REDIRECT_URI=
# 선택: 실제 GitHub OAuth 연결. 활성화 시 아래 설정 전체가 필수(기능 문서 참고).
GITHUB_CONNECTION_ENABLED=false
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=
# Git 밖의 전용 영속 디렉터리 절대 경로. 실제 토큰 암호문만 보관한다.
GITHUB_CREDENTIAL_DIRECTORY=
# 안전한 별도 난수 32바이트의 64자리 hex. 실제 값·기본값을 제공하지 않는다.
GITHUB_CREDENTIAL_ENCRYPTION_KEY=
# 선택: 분석 합성 주입 모듈 연결 시 사용. development/test + 정확히 true에서만 허용.
# 현재 AppModule에는 주입 경로가 없으며 이 값만 바꿔 HTTP API를 열 수 없습니다.
DEV_ANALYSIS_INJECTION_ENABLED=false
# 선택: WorkerContextModule에 실제 선정 공급자를 명시적으로 조립한 경우에만 내부 조회를 활성화.
# 이 설정만으로 경로는 생기지 않습니다. api/docs/worker-context.md 참고.
WORKER_CONTEXT_ENABLED=false
# 활성화 시 필수: 다른 키와 별개인 난수 32바이트의 64자리 hex. 기본값 없음.
WORKER_CONTEXT_API_KEY=
# 선택: 개발 로그인은 development/test에서만 허용. 미지정·그 밖의 값에서는 플래그가 true여도 거부.
# 운영에서는 반드시 production.
NODE_ENV=development
# 운영 필수: 공유 링크 url을 만들 web 주소. NODE_ENV가 development·test일 때만 http 주소를 받고, 비우면 http://localhost:3000을 씁니다.
# 그 밖(production·미지정 포함)에서는 https 주소가 없으면 api가 기동하지 않습니다.
SHARE_LINK_WEB_BASE_URL=
# 운영 필수: 비밀번호 링크 열람 증표(grant) 서명 키. 32바이트 무작위 값의 64자리 hex, AUTH_JWT_SECRET과 달라야 합니다.
# NODE_ENV가 development·test일 때만 비울 수 있고, 이때는 실행할 때마다 임시 키를 만들어 api를 다시 켜면 비밀번호를 다시 입력합니다.
# 그 밖(production·미지정 포함)에서는 비우면 api가 기동하지 않습니다.
LINK_GRANT_SECRET=
# 선택: HTTP 포트 (기본값 3001, 허용 범위 1~65535)
PORT=3001
# 선택: web이 다른 출처에서 api를 부를 때 허용할 출처(쉼표 구분). 비우면 CORS를 켜지 않습니다.
# 로컬 web 개발 주소만 둡니다. web은 http://localhost:3000으로 엽니다.
# 운영은 web/API 동일 출처이므로 반드시 비웁니다. 개발 허용 출처는 쿠키(credentials)를 지원합니다.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# 선택: 신뢰할 프록시(부하분산기)의 IP 또는 CIDR, 쉼표로 구분. 비우면 직접 연결 주소를 쓰고 X-Forwarded-For를 무시합니다.
# 로컬에서는 비워 둡니다. 배포에서는 부하분산기 대역만 넣습니다(넓게 열면 수신자가 주소를 꾸며 비밀번호 시도 제한을 피할 수 있음).
TRUST_PROXY_CIDRS=
# 선택: HTTP 바인딩 주소 (기본값 127.0.0.1, IP 주소만 허용). 0.0.0.0은 같은 네트워크의 다른 기기에서도 접속되므로
# 컨테이너 등 다른 주소에서 접속해야 할 때만 바꿉니다.
BIND_HOST=127.0.0.1
# 필수: 개발 DB 접속. README 「로컬 DB 준비」의 docker run 명령과 같은 로컬 컨테이너 전용 값입니다.
# 실제 서버 접속 정보는 이 예시에 넣지 않습니다.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=catchu
DB_PASSWORD=catchu_local
DB_NAME=catchu
# 선택: 분석 큐 연결(#233). 이 값만으로 AppModule에서 분석 큐 연결이 켜지지 않습니다(모듈 미등록, docs/analysis-queue.md).
# 백그라운드 AI 실행 AiRun(U2)은 이 주소가 있으면 기동 때 ai-run 큐에 붙습니다(docs/ai-run.md).
# 운영은 비밀번호가 든 rediss:// 주소만 받습니다. 주소 전체가 비밀값이므로 실제 값을 이 예시에 넣지 않습니다.
CATCHU_QUEUE_REDIS_URL=
# 선택: 큐 키 접두사(기본 catchu). worker와 같아야 합니다.
CATCHU_QUEUE_PREFIX=
# 11월 AI 기능의 외부 제공자 키(#389). 이름만 먼저 정했고, 읽는 코드는 11월 Unit이 넣습니다(생성: U1·U2, 임베딩: U3).
# 일반 개발·시험은 합성 제공자로 돌리므로 비워 둡니다. 실제 키는 로컬 .env에만 넣고 Git·로그·대화에 공유하지 않습니다.
# SDK가 스스로 읽는 이름(ANTHROPIC_API_KEY·VOYAGE_API_KEY)은 쓰지 않습니다(worker의 CATCHU_GENERATION_API_KEY와 같은 규칙).
# 생성 제공자(Claude API) 키. U1 게이트(src/ai-generation, 앱 미등록)와 실제 호출 시험(test/ai-generation/live-citation.test.cjs)이 읽음.
# 실제 호출 시험은 셸 환경변수로 줄 때만 돌고, 비우면 미실행으로 건너뜁니다(docs/ai-generation.md).
CATCHU_GENERATION_API_KEY=
# 임베딩 제공자(Voyage AI) 키. api 기동 때 판정합니다: 비우면 NODE_ENV가 development·test일 때만 합성 제공자로 뜨고,
# 그 밖(production·미지정)에서는 기동하지 않습니다(docs/published-index.md 「키와 합성 제공자」).
CATCHU_EMBEDDING_API_KEY=
# 선택: Claude 연결(12월 U6, docs/claude-mcp.md)의 접근 토큰 수명(초). 비우면 7일이고 7일을 넘기면 기동하지 않습니다. 만료 재승인을 확인할 때만 줄입니다.
MCP_ACCESS_TOKEN_TTL_SECONDS=
# 선택: 아래 둘은 NODE_ENV가 development·test일 때만 받습니다. 그 밖에서 값이 있으면 기동하지 않습니다.
# MCP 공개 주소(끝 슬래시 없는 출처). 비우면 http://127.0.0.1:{PORT}. 터널로 실제 Claude를 붙여 볼 때만 씁니다.
MCP_DEV_PUBLIC_ORIGIN=
# Claude 콜백 말고 더 받을 돌아갈 주소(쉼표 구분, 정확히 일치). 비우면 Claude 콜백 하나뿐입니다.
MCP_DEV_REDIRECT_URIS=
# 선택: npm test가 쓰는 테스트 DB(README 「DB 테스트」). 없으면 아래와 같은 기본값을 씁니다. 이름은 _test로 끝나야 합니다.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5433
TEST_DB_USER=catchu
TEST_DB_PASSWORD=catchu_local
TEST_DB_NAME=catchu_test
