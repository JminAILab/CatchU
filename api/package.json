{
  "name": "@catchu/api",
  "version": "0.0.0",
  "private": true,
  "description": "CatchU API 최소 실행 골격",
  "type": "commonjs",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "start:dev": "node --env-file-if-exists=.env --watch -r ts-node/register src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node scripts/test-with-db.cjs",
    "test:coverage": "npm run build && node scripts/test-with-db.cjs --coverage",
    "test:analysis-fixtures": "npm run build && node --test test/analysis/shared-fixtures.check.cjs",
    "build": "node scripts/clean-dist.cjs && tsc -p tsconfig.build.json",
    "migration:generate": "node --env-file-if-exists=.env ./node_modules/typeorm/cli-ts-node-commonjs.js migration:generate -d src/database/data-source.ts",
    "migration:run": "node --env-file-if-exists=.env ./node_modules/typeorm/cli-ts-node-commonjs.js migration:run -d src/database/data-source.ts",
    "migration:revert": "node --env-file-if-exists=.env ./node_modules/typeorm/cli-ts-node-commonjs.js migration:revert -d src/database/data-source.ts",
    "test:catches:db": "npm run build && node scripts/test-catches-db.cjs",
    "rag-eval": "npm run build && node --env-file-if-exists=.env scripts/rag-eval/rag-eval.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nestjs/common": "12.0.4",
    "@nestjs/core": "12.0.4",
    "@nestjs/platform-express": "12.0.4",
    "@nestjs/typeorm": "12.0.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "bullmq": "6.3.11",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "eslint": "10.11.0",
    "globals": "16.5.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    },
    "typeorm": {
      "ioredis": "$ioredis"
    }
  }
}
