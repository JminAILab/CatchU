{
  "name": "catchu-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.21.0",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:run": "node scripts/smoke.mjs",
    "test": "node --test test/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/**/*.ts --test-coverage-include=src/**/*.tsx test/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:run"
  },
  "dependencies": {
    "next": "16.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "typescript": "^5"
  }
}
