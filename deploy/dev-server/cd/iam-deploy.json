{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "EcrPushFiveRepositories",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:CompleteLayerUpload",
        "ecr:DescribeImages",
        "ecr:GetDownloadUrlForLayer",
        "ecr:InitiateLayerUpload",
        "ecr:PutImage",
        "ecr:UploadLayerPart"
      ],
      "Resource": [
        "arn:aws:ecr:ap-northeast-2:ACCOUNT_ID:repository/catchu-web",
        "arn:aws:ecr:ap-northeast-2:ACCOUNT_ID:repository/catchu-api",
        "arn:aws:ecr:ap-northeast-2:ACCOUNT_ID:repository/catchu-api-migration",
        "arn:aws:ecr:ap-northeast-2:ACCOUNT_ID:repository/catchu-worker",
        "arn:aws:ecr:ap-northeast-2:ACCOUNT_ID:repository/catchu-deploy-files"
      ]
    },
    {
      "Sid": "SendDeployDocumentToDevServerOnly",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ssm:ap-northeast-2:ACCOUNT_ID:document/catchu-dev-deploy",
        "arn:aws:ec2:ap-northeast-2:ACCOUNT_ID:instance/INSTANCE_ID"
      ]
    },
    {
      "Sid": "ReadCommandResult",
      "Effect": "Allow",
      "Action": "ssm:GetCommandInvocation",
      "Resource": "*"
    }
  ]
}
