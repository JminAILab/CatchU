# 실행 묶음(docker compose --env-file). 비밀값을 두지 않는다. 실제 파일은 저장소 밖 환경 폴더에 compose.env로 둔다.
# 교체할 때는 이미지 값만 바꾸고 deploy/scripts/replace-single.sh를 실행한다.
CATCHU_SINGLE_NAME=catchu-single
# api.env·migration.env가 있는 저장소 밖 폴더(절대 경로)
CATCHU_ENV_DIR=/절대/경로/catchu-env
# DB 서버 인증서를 발급한 CA 파일(절대 경로). api·migration에 읽기 전용으로 넣는다.
CATCHU_DB_CA_FILE=/절대/경로/db-ca.pem
# 같은 소스 판본으로 만든 네 이미지. 배포에는 태그 대신 digest(@sha256:...)를 쓴다.
CATCHU_WEB_IMAGE=<레지스트리>/catchu-web@sha256:<digest>
CATCHU_API_IMAGE=<레지스트리>/catchu-api@sha256:<digest>
CATCHU_MIGRATION_IMAGE=<레지스트리>/catchu-api-migration@sha256:<digest>
CATCHU_WORKER_IMAGE=<레지스트리>/catchu-worker@sha256:<digest>
# 호스트의 127.0.0.1에만 여는 포트
CATCHU_WEB_PORT=3000
CATCHU_API_PORT=3001
CATCHU_WORKER_PORT=8000
