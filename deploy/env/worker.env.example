# worker(분석 소비자, #121) 실행 값. 실제 파일은 저장소 밖 환경 폴더에 worker.env로 둔다. 설명은 worker/docs/queue-consumer.md.
# compose.single.yaml이 NODE_ENV=production을 고정한다. 운영에서 아래 값이 없거나 틀리면 worker가 기동하지 않는다.
# 큐 서버 주소(필수). 운영은 rediss://(TLS)만 받는다. 주소에 비밀번호가 들어가므로 주소 전체가 비밀값이다. 질의 문자열은 받지 않는다.
CATCHU_QUEUE_REDIS_URL=rediss://:<비밀번호>@<큐 주소>:6379
# 큐 키 접두사(선택, 기본 catchu). api(#233)와 같은 값이어야 한다.
CATCHU_QUEUE_PREFIX=catchu
# 이 프로세스의 동시 분석 수(선택, 기본 1, 1~4). 소비자를 여러 개 띄우면 전체 동시 수는 그 합이다.
CATCHU_WORKER_CONCURRENCY=1
# MOCK 요청 처리(선택). 운영에서는 켤 수 없다(true면 기동하지 않는다).
CATCHU_WORKER_MOCK=false
