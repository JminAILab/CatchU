# worker(분석 소비자, #121) 실행 값. 실제 파일은 저장소 밖 환경 폴더에 worker.env로 둔다. 설명은 worker/docs/queue-consumer.md.
# compose.single.yaml이 NODE_ENV=production을 고정한다. 운영에서 아래 값이 없거나 틀리면 worker가 기동하지 않는다.
# 큐 서버 주소(필수). 운영은 rediss://(TLS)만 받는다. 주소에 비밀번호가 들어가므로 주소 전체가 비밀값이다. 질의 문자열은 받지 않는다.
CATCHU_QUEUE_REDIS_URL=rediss://:<비밀번호>@<큐 주소>:6379
# 큐 키 접두사(선택, 기본 catchu). api(#233)와 같은 값이어야 한다.
CATCHU_QUEUE_PREFIX=catchu
# 이 프로세스의 동시 분석 수(선택, 기본 1). 지금은 1만 받는다(2 이상이면 기동하지 않는다).
CATCHU_WORKER_CONCURRENCY=1
# MOCK 요청 처리(선택). 운영에서는 켤 수 없다(true면 기동하지 않는다).
CATCHU_WORKER_MOCK=false
# 요청 정보 조회(필수). api의 worker 전용 조회 주소와 키(api의 WORKER_CONTEXT_API_KEY와 같은 64자리 16진수, 비밀값).
# 운영은 https:// 주소이거나, 아래 설정을 켠 클러스터 안 서비스 이름(<서비스>.<네임스페이스>.svc.cluster.local)의 http:// 주소다.
WORKER_CONTEXT_API_URL=https://<내부 api 주소>
WORKER_CONTEXT_API_KEY=<64자리 16진수>
# 클러스터 안 http 조회 허용(선택, 기본 false). 망 제한(NetworkPolicy)과 Pod 특권 금지가 함께 있어야 한다(worker/docs/request-context.md).
WORKER_CONTEXT_API_ALLOW_CLUSTER_HTTP=false
# 생성 제공자(Claude API) 키(필수, 비밀값). 실제 API 호출은 팀장 허가 뒤에만 한다(worker/docs/generation-provider.md).
CATCHU_GENERATION_API_KEY=<Claude API 키>
# AI 쪽(CR3) 판정 공급자(선택, 기본 openai·claude)와 OpenAI 판정 키(선택, 비밀값). 고지 v3가 배포된 뒤에만 넣는다
# (worker/docs/generation-judgement.md 「켜고 끄기」). 넣지 않으면 AI 쪽이 꺼진 채 기동한다. claude만 넣어도 생성 키로 켜진다.
# CATCHU_JUDGEMENT_PROVIDER=openai
# CATCHU_JUDGEMENT_API_KEY=<OpenAI 판정 키>
