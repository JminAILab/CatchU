# 분석 요청 큐 소비자(python -m app.consumer) 환경변수. 설명은 docs/queue-consumer.md 「설정」.
# .env를 자동으로 읽지 않는다. 셸이나 실행 환경에서 넣는다. FastAPI 개발 서버(app.main)는 읽지 않는다.
# development·test만 개발 동작(평문 큐 주소, MOCK 처리, 큐 주소 없이 기동)을 연다. 기본은 production이다.
NODE_ENV=development
# 큐 서버 주소. 운영은 rediss://만 받고 필수다. 개발·시험에서 비우면 소비자를 끄고 상태 확인만 띄운다.
CATCHU_QUEUE_REDIS_URL=redis://127.0.0.1:6379
# 선택. 큐 키 접두사(기본 catchu), 동시 분석 수(기본 1, 지금은 1만 받음), MOCK 처리(개발·시험 기본 켬, 운영에서 켜면 기동 실패).
CATCHU_QUEUE_PREFIX=catchu
CATCHU_WORKER_CONCURRENCY=1
CATCHU_WORKER_MOCK=true

# LIVE 처리 설정(요청 정보 조회와 생성 제공자). 운영은 셋 다 필수다. 개발·시험에서 셋 다 비우면 LIVE 요청을
# 처리 전에 거부하고, 일부만 넣으면 기동하지 않는다. 설명은 docs/request-context.md 「설정」.
# WORKER_CONTEXT_API_URL=https://internal-api.example
# WORKER_CONTEXT_API_KEY=<api와 맞춘 worker 전용 32바이트 난수의 64자리 16진수>
# development/test에 한해 숫자 loopback의 HTTP origin을 허용한다.
# 예: WORKER_CONTEXT_API_URL=http://127.0.0.1:3001
# 운영 http는 아래를 켜고 클러스터 안 서비스 이름(<서비스>.<네임스페이스>.svc.cluster.local)일 때만 받는다.
# WORKER_CONTEXT_API_ALLOW_CLUSTER_HTTP=false
# 생성 제공자(Claude API) 키. SDK 환경변수 ANTHROPIC_API_KEY는 쓰지 않는다.
# CATCHU_GENERATION_API_KEY=<Claude API 키>
# AI 쪽(CR3) 판정 공급자(openai 기본·claude)와 OpenAI 판정 키. 둘 다 선택이고, 넣지 않으면 AI 쪽이 꺼진다.
# claude는 위 생성 키로 켜진다. SDK 환경변수 OPENAI_API_KEY는 쓰지 않는다. 설명은 docs/generation-judgement.md.
# CATCHU_JUDGEMENT_PROVIDER=openai
# CATCHU_JUDGEMENT_API_KEY=<OpenAI 판정 키>
# 실제 키·GitHub 토큰은 이 파일·로그·Git에 적지 않는다.

# PDF 글 추출 소비자(같은 프로세스의 둘째 Worker, 큐 pdf-extraction-requests). 아래 두 읽기 경로 가운데 하나만 넣는다.
# 둘 다 비우면 PDF 소비자를 띄우지 않고, 둘 다 넣으면 기동하지 않는다. worker는 PDF를 읽기만 한다.
# 로컬·시험: api의 FILE_STORAGE_LOCAL_ROOT와 같은 폴더(읽기 전용으로 붙인다)의 절대 경로.
# PDF_FILE_ROOT=/var/lib/catchu/files
# 배포: api와 같은 버킷 이름. 접근 키는 넣지 않고 AWS 기본 자격 체인(역할)을 쓴다. 지역은 boto3가 읽는 AWS_DEFAULT_REGION으로 준다.
# FILE_STORAGE_S3_BUCKET=
# AWS_DEFAULT_REGION=ap-northeast-2
# 선택. 동시 추출 수(기본 1, 지금은 1만 받음), 자식 프로세스의 총 시간(기본 120초, 1~600), 메모리 제한(기본 512 MB, 64~16384, Linux에서만 적용).
# 읽기 경로 없이 아래 값만 넣으면 기동하지 않는다.
# CATCHU_WORKER_PDF_CONCURRENCY=1
# CATCHU_WORKER_PDF_CHILD_TIMEOUT_SECONDS=120
# CATCHU_WORKER_PDF_CHILD_MEMORY_MB=512
