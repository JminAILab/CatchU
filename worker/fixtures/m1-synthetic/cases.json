          "file": "results/empty.json",
          "schema": "Result",
          "check": {
            "verdict": "VALID",
            "unidentifiedFields": []
          },
          "expected": {
            "processingAfter": "EMPTY",
            "receipt": {
              "disposition": "ACCEPTED",
              "code": "OK"
            },
            "registration": "NONE",
            "catchesAfter": 0
          },
          "note": "근거 부족은 notProvided에 있고 failures는 비어 있다. 오류가 아니다."
        }
      ]
    },
