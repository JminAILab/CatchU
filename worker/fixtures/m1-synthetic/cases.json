    {
      "caseId": "succeeded-one-candidate",
      "issueName": "적합 후보 1건(SUCCEEDED)",
      "delivery": "IN_ORDER",
      "messages": [
        {
          "file": "results/succeeded-one-candidate.json",
          "schema": "Result",
          "check": {
            "verdict": "VALID",
            "unidentifiedFields": []
          },
          "expected": {
            "processingAfter": "SUCCEEDED",
            "receipt": {
              "disposition": "ACCEPTED",
              "code": "OK"
            },
            "registration": "NEW_CATCH",
            "catchesAfter": 1
          },
          "note": "후보 1건이 새 PRIVATE Catch 1개가 된다. 수신 확인 ACCEPTED는 등록 완료를 뜻하지 않는다."
        }
      ]
    },
    {
